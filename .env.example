# Browser-safe Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only payment configuration. Never prefix these keys with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
# Exact public origin, no trailing path. Use localhost only for local testing.
SITE_URL=http://localhost:3010
# Operator-approved NGN per USD. Leave blank to keep checkout disabled.
PAYMENT_USD_NGN_RATE=
